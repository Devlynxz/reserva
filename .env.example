# Reserva environment. Copy to `.env` for local development.
# REQUIRED variables must be set in every environment. OPTIONAL integrations degrade
# gracefully when unset (no emails, no online payments, no background jobs, …).
# Validated at runtime by src/server/env.ts.

# ── Database — REQUIRED ─────────────────────────────────────────────────────
# On Vercel both are set automatically by the Neon integration (Storage → Neon).
# Pooled URL: used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/reserva?sslmode=require"
# Direct URL: used by Prisma CLI for migrations (`db:migrate`, `db:deploy`). Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/reserva?sslmode=require"

# ── Tests — OPTIONAL ────────────────────────────────────────────────────────
# Database-backed tests run ONLY against this database and TRUNCATE it freely. Never point
# it at real data. Without it, those suites are skipped.
TEST_DATABASE_URL=""

# ── Seeding — OPTIONAL (`npm run db:seed`) ─────────────────────────────────
# resort | court | salon. Seeding WIPES the database first.
SEED_PRESET="resort"
# Logins for the seeded owner and staff member. Required in production; demo defaults otherwise.
SEED_ADMIN_PASSWORD=""
SEED_STAFF_PASSWORD=""
# "false" seeds the catalog and accounts without the ~15 sample bookings (real clients).
SEED_SAMPLE_BOOKINGS="true"
# Must be "true" to seed with NODE_ENV=production.
SEED_ALLOW_RESET=""

# ── Auth — REQUIRED ─────────────────────────────────────────────────────────
# At least 32 random characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
# Public origin of this deployment (no trailing slash).
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Payments — OPTIONAL (online deposits are off when "none") ──────────────
# paymongo | stripe | none. PayMongo requires Settings.currency = PHP.
# Webhook setup and local testing: docs/PAYMENTS.md
PAYMENT_PROVIDER="none"
# Required when PAYMENT_PROVIDER=paymongo (use test keys until the client goes live)
PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""
# Required when PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Email (Resend) — OPTIONAL ───────────────────────────────────────────────
RESEND_API_KEY=""
# Required when RESEND_API_KEY is set, e.g. "Villa Serena <bookings@villaserena.ph>"
EMAIL_FROM=""

# ── Background jobs (Inngest) — OPTIONAL ────────────────────────────────────
# Set automatically by the Inngest Vercel integration. Without them, holds still
# expire lazily on the next booking attempt; reminders aren't sent.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ── Photo uploads (Vercel Blob) — OPTIONAL ──────────────────────────────────
# Set automatically when a Blob store is connected. Without it, photo upload is hidden.
BLOB_READ_WRITE_TOKEN=""

# ── Monitoring (Sentry) — OPTIONAL ──────────────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ── Rate limiting — OPTIONAL ────────────────────────────────────────────────
# Header holding the real client IP. Vercel sets x-real-ip; change only behind another proxy.
CLIENT_IP_HEADER="x-real-ip"

# ── Deploy — OPTIONAL ───────────────────────────────────────────────────────
# Preview deployments skip `prisma migrate deploy` unless this is "true" (only with Neon
# preview branches — never when previews share production's database). docs/DEPLOY.md
MIGRATE_ON_PREVIEW=""

# ── Content-Security-Policy — OPTIONAL ─────────────────────────────────────
# "report-only" logs violations in the browser console without blocking anything.
CSP_MODE="enforce"

# ── Demo — OPTIONAL ─────────────────────────────────────────────────────────
# "true" shows the demo banner and one-click owner/staff sign-in, and locks settings and
# team changes. NEVER on a real client's site: anyone could sign in as the owner.
DEMO_MODE="false"
