# Reserva environment. Copy to `.env` for local development.
# REQUIRED variables must be set in every environment. OPTIONAL integrations degrade
# gracefully when unset (no emails, no online payments, no background jobs, …).
# Validated at runtime by src/server/env.ts.

# ── Database — REQUIRED ─────────────────────────────────────────────────────
# On Vercel both are set automatically by the Neon integration (Storage → Neon).
# Pooled URL: used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/reserva?sslmode=require"
# Direct URL: used by Prisma CLI for migrations (`db:migrate`, `db:deploy`). Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/reserva?sslmode=require"

# ── Auth — REQUIRED ─────────────────────────────────────────────────────────
# At least 32 random characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
# Public origin of this deployment (no trailing slash).
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Payments — OPTIONAL (online deposits are off when "none") ──────────────
# paymongo | stripe | none. PayMongo requires Settings.currency = PHP.
PAYMENT_PROVIDER="none"
# Required when PAYMENT_PROVIDER=paymongo (use test keys until the client goes live)
PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""
# Required when PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Email (Resend) — OPTIONAL ───────────────────────────────────────────────
RESEND_API_KEY=""
# Required when RESEND_API_KEY is set, e.g. "Villa Serena <bookings@villaserena.ph>"
EMAIL_FROM=""

# ── Background jobs (Inngest) — OPTIONAL ────────────────────────────────────
# Set automatically by the Inngest Vercel integration. Without them, holds still
# expire lazily on the next booking attempt; reminders aren't sent.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ── Photo uploads (Vercel Blob) — OPTIONAL ──────────────────────────────────
# Set automatically when a Blob store is connected. Without it, photo upload is hidden.
BLOB_READ_WRITE_TOKEN=""

# ── Monitoring (Sentry) — OPTIONAL ──────────────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ── Rate limiting — OPTIONAL ────────────────────────────────────────────────
# Header holding the real client IP. Vercel sets x-real-ip; change only behind another proxy.
CLIENT_IP_HEADER="x-real-ip"

# ── Demo — OPTIONAL ─────────────────────────────────────────────────────────
# "true" shows the demo banner and a one-click demo admin login.
DEMO_MODE="false"
